# Base URL of the Go backend (HTTP/WS scheme, no trailing slash).
# Required in production, where the frontend and backend are not served from
# the same host on port 8080 (e.g. the backend deployed to Fly.io behind HTTPS).
# Leave unset for local dev to auto-target http(s)://<current-host>:8080.
VITE_BACKEND_URL=https://remi-backend.fly.dev
